{
  "name": "@rxjs-operators/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "release": "nx release",
    "build:or-empty-array": "nx build or-empty-array",
    "publish:or-empty-array": "npm run build:or-empty-array && npm publish -w or-empty-array"
  },
  "private": true,
  "dependencies": {
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nx/jest": "^23.2.1",
    "@nx/js": "^23.2.1",
    "@nx/vite": "^23.2.1",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@swc/jest": "^0.2.39",
    "@types/jest": "~30.0.0",
    "@types/node": "^22.20.5",
    "jest": "~30.3.0",
    "jest-environment-node": "~30.3.0",
    "jest-util": "~30.3.0",
    "nx": "23.2.1",
    "prettier": "~3.6.2",
    "ts-jest": "^29.4.7",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "verdaccio": "^6.3.2"
  },
  "workspaces": [
    "packages/*"
  ],
  "nx": {
    "includedScripts": [],
    "targets": {
      "local-registry": {
        "executor": "@nx/js:verdaccio",
        "options": {
          "port": 4873,
          "config": ".verdaccio/config.yml",
          "storage": "tmp/local-registry/storage"
        }
      }
    }
  }
}
